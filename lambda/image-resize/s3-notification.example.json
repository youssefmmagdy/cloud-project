{
  "LambdaFunctionConfigurations": [
    {
      "Id": "image-resize-on-upload",
      "LambdaFunctionArn": "arn:aws:lambda:eu-north-1:ACCOUNT_ID:function:image-resize",
      "Events": [
        "s3:ObjectCreated:Put",
        "s3:ObjectCreated:CompleteMultipartUpload"
      ],
      "Filter": {
        "Key": {
          "FilterRules": [
            {
              "Name": "prefix",
              "Value": "students/"
            }
          ]
        }
      }
    }
  ]
}
